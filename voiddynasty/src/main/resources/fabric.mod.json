{
	"schemaVersion": 1,
	"id": "voiddynasty",
	"version": "${version}",
	"name": "Void Dynasty",
	"description": "VOID DYNASTY unified: fleet, weapons, containers, persistent servitor AI and optional Rogue Trader deliveries.",
	"authors": [
		"Donopot (via Hermes / universal-modder)"
	],
	"license": "MIT",
	"environment": "*",
	"accessWidener": "voiddynasty.accesswidener",
	"entrypoints": {
		"main": [
			"com.donopot.voiddynasty.VoidDynastyMod",
			"com.donopot.voiddynastybridge.BridgeMod"
		],
		"client": [
			"com.donopot.voiddynasty.client.VoidDynastyModClient",
			"com.donopot.voiddynastybridge.VoidDynastyBridgeClient"
		]
	},
	"mixins": [
		"voiddynasty.mixins.json",
		"voiddynasty-bridge.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"geckolib": "*"
	},
	"breaks": {
		"voiddynasty_bridge": "*"
	},
	"custom": {
		"voiddynasty:bundled_bridge": "0.7.1"
	}
}
