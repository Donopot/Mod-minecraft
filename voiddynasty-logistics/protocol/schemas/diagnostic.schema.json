{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:void-dynasty:diagnostic:1",
  "title": "VOID DYNASTY read-only diagnostic channel v1",
  "$comment": "Separate from delivery protocol. Hello max 4096 UTF-8 bytes including LF; snapshots max 65536.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "token"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "const": "diagnostic_hello"
        },
        "token": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "writeOnly": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "diagnostic_only",
        "delivery_enabled",
        "session_id",
        "sequence",
        "campaign_loaded",
        "native_campaign_id",
        "zone",
        "game_mode",
        "save_state",
        "status"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "const": "diagnostic_snapshot"
        },
        "diagnostic_only": {
          "const": true
        },
        "delivery_enabled": {
          "const": false
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "campaign_loaded": {
          "type": "boolean"
        },
        "native_campaign_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "zone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "game_mode": {
          "type": "string",
          "maxLength": 128
        },
        "save_state": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "maxLength": 1024
        }
      }
    }
  ]
}
