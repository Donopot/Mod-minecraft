{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live repeatable delivery response v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply_to",
    "code",
    "session_id",
    "campaign_id",
    "world_id",
    "pair_id",
    "checkpoint_id",
    "delivery_id",
    "state",
    "payload_hash",
    "zone",
    "campaign_name",
    "last_receipt_id",
    "protocol_version",
    "reserve",
    "completed_count",
    "available"
  ],
  "properties": {
    "reply_to": {
      "type": "string",
      "maxLength": 1024
    },
    "code": {
      "type": "string",
      "maxLength": 1024
    },
    "session_id": {
      "type": "string",
      "maxLength": 1024
    },
    "campaign_id": {
      "type": "string",
      "maxLength": 1024
    },
    "world_id": {
      "type": "string",
      "maxLength": 1024
    },
    "pair_id": {
      "type": "string",
      "maxLength": 1024
    },
    "checkpoint_id": {
      "type": "string",
      "maxLength": 1024
    },
    "delivery_id": {
      "type": "string",
      "maxLength": 1024
    },
    "state": {
      "type": "string",
      "maxLength": 1024
    },
    "payload_hash": {
      "type": "string",
      "maxLength": 1024
    },
    "zone": {
      "type": "string",
      "maxLength": 1024
    },
    "campaign_name": {
      "type": "string",
      "maxLength": 1024
    },
    "last_receipt_id": {
      "type": "string",
      "maxLength": 1024
    },
    "protocol_version": {
      "const": 3
    },
    "reserve": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2560,
      "multipleOf": 10
    },
    "completed_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "available": {
      "type": "boolean"
    }
  }
}
